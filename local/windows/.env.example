# Copy to local/windows/.env or let scripts/setup-local-n8n.ps1 create it for you.

COMPOSE_PROJECT_NAME=n8n-local
N8N_IMAGE_NAME=n8n-local:workspace
NODE_VERSION=24.14.1
PNPM_VERSION=10.32.1

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
N8N_ENCRYPTION_KEY=__GENERATE_N8N_ENCRYPTION_KEY__

N8N_HOST=localhost
N8N_PROTOCOL=http
INSTANCE_BASE_URL=http://localhost:5678

GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

N8N_MCP_BUILDER_ENABLED=true
N8N_SECURE_COOKIE=false
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
