# Generated automatically by scripts/setup-local-n8n-host.ps1 on first run.

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_USER_FOLDER=__N8N_USER_FOLDER__
DB_TYPE=sqlite
DB_SQLITE_DATABASE=__DB_SQLITE_DATABASE__
DB_SQLITE_POOL_SIZE=3
N8N_ENCRYPTION_KEY=__GENERATE_N8N_ENCRYPTION_KEY__
N8N_MCP_BUILDER_ENABLED=true
N8N_SECURE_COOKIE=false
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York
